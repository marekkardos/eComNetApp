{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Ef": {
      "EnableDetailedErrors": true,
      "EnableSensitiveDataLogging": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnectionMssql": "Server=localhost; Database=eCommNetDb; User Id=sa; Password=Strong!Passw0rd;TrustServerCertificate=True",
    "IdentityConnectionMssql": "Server=localhost; Database=eCommNet_IdentityDb; User Id=sa; Password=Strong!Passw0rd;TrustServerCertificate=True",
    "Redis": "localhost"
  },
  "Token": {
    "Key": "super secret key and now has to be even much longer longer longer longer longer longer longer longer longer longer....",
    "Issuer": "eComNetApp"
  },
  "TokenSettings": {
    "AccessTokenExpirationMinutes": 1,
    "RefreshTokenExpirationDays": 7,
    "CookieName": "refreshToken"
  },
  "LockoutSettings": {
