meta {
  name: 01 - post /api/Account/login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Account/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userName}}",
    "password": "{{userPwd}}"
  }
}

tests {
  test("Status is 200", function() {
    expect([200]).to.include(res.status);
  });
  
  if (res.body.token) {
       bru.setEnvVar("authToken", res.body.token);
     }
}

example {
  name: 200 Response
  description: Success
  
  request: {
    url: {{baseUrl}}/api/Account/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "email": "",
          "displayName": "",
          "token": ""
        }
      '''
    }
  }
}

